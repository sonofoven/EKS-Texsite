apiVersion: helm.toolkit.fluxcd.io/v2
kind: HelmRelease
metadata:
  name: aws-load-balancer-controller
  namespace: flux-system
spec:
  interval: 10m
  chart:
    spec:
      chart: aws-load-balancer-controller
      sourceRef:
        kind: HelmRepository
        name: eks
        namespace: flux-system
      interval: 10m
  targetNamespace: kube-system
  values:
    clusterName: ${EKS_CLUSTER_NAME}
    serviceAccount:
      create: false
      name: aws-load-balancer-controller
